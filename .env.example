# SmartProBono Lite Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# SUPABASE (Backend-as-a-Service)  — REQUIRED
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# AI PROVIDERS
# ============================================
# At least one provider is needed for chat. Set AI_PROVIDER to "groq" or "huggingface".
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Optional — only needed if AI_PROVIDER=huggingface
HUGGINGFACE_API_KEY=

# Optional — needed for RAG embeddings (vector search)
OPENAI_API_KEY=

# ============================================
# EMAIL SERVICE (Resend)  — Optional
# ============================================
# Required for early-access waitlist and notification emails
RESEND_API_KEY=

# ============================================
# STRIPE BILLING  — Optional
# ============================================
# Required for Pro subscription checkout flow
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
# Optional annual price variant
STRIPE_PRICE_ID_PRO_ANNUAL=
# Webhook signature verification
STRIPE_WEBHOOK_SECRET=
# Path to redirect after successful checkout (default: /success)
NEXT_PUBLIC_STRIPE_SUCCESS_PATH=/success

# ============================================
# POSTHOG ANALYTICS  — Optional
# ============================================
# Client-side event capture
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side capture and feature flags
POSTHOG_SECRET_KEY=

# ============================================
# APP CONFIG
# ============================================
# Public URL of the deployed app (used for Stripe redirect origins, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated admin emails for /internal/* and /api/internal/* (required in production)
ADMIN_EMAILS=

# Set to "true" only on local dev when ADMIN_EMAILS is empty — allows any signed-in user to access internal diagnostics.
# Never enable in production.
INTERNAL_API_ALLOW_UNSCOPED=

# ============================================
# SENTRY ERROR MONITORING  — Optional
# ============================================
# Client-side DSN (public, safe to expose)
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN (can be same as above)
SENTRY_DSN=
# Org and project slugs for source map uploads
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ============================================
# DEPLOYMENT
# ============================================
# LangGraph v1 requires Node 20+ (https://docs.langchain.com/oss/javascript/migrate/langgraph-v1)
NODE_VERSION=20

# ============================================
# AGENTS / LANGGRAPH
# ============================================
# When "true", every chat turn that reaches the LLM stage routes through the
# six-agent LangGraph workflow (Intake -> Research -> Analysis -> Document? ->
# Strategy -> Safety). Leave unset/false to keep the legacy single-pass path.
# Per-request override: POST /api/chat with { "use_agents": true }.
AGENTS_DEFAULT_ON=false

# ============================================
# COURTLISTENER (Free Law Project)  — Optional
# ============================================
# Secondary research source used by the Research agent for case-law context.
# Supabase RAG (curated RI handbook) remains the PRIMARY source; CourtListener
# is only merged in for supporting authority. Keep disabled until smoke tests
# pass against your token + jurisdiction.
COURTLISTENER_API_TOKEN=
COURTLISTENER_ENABLED=false
COURTLISTENER_MAX_RESULTS=5
